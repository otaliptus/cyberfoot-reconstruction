+            return false;
+        }
+        U32 total = 0;
+        while (total < size) {
+            int count = unzReadCurrentFile(zipfile, data + total, size - total);
+            if (count <= 0) {
+                unzCloseCurrentFile(zipfile);
+                return false;
+            }
+            total += count;
+        }
+        // Publish only complete, CRC-verified contents. On failure the caller
+        // falls back to the existing ZIP reader with its stream state reset.
+        return unzCloseCurrentFile(zipfile) == UNZ_OK;
+    });
+}

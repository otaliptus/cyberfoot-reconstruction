+// Cyberfoot-specific, optional web runtime instrumentation (GPL-2.0-or-later).
+#pragma once
+#if defined(__EMSCRIPTEN__) && defined(BOXEDWINE_MULTI_THREADED)
+#include <atomic>
+enum CfMetric { CF_DISPATCH, CF_QUEUE_US, CF_EXEC_US, CF_RESUME_US,
+ CF_MAX_QUEUE_US, CF_MAX_EXEC_US, CF_FRAMES, CF_COMPOSE_US, CF_UPLOADS,
+ CF_UPLOAD_PIXELS, CF_FLUSH, CF_PUT_IMAGE, CF_PUT_IMAGE_US, CF_WAKE,
+ CF_WAKE_COALESCED, CF_DEFERRED_FLUSH, CF_MAIN_TICKS, CF_METRIC_COUNT };
+extern std::atomic<unsigned long long> cfMetrics[CF_METRIC_COUNT];
+extern std::atomic<unsigned> cfMode;
+inline void cfAdd(CfMetric id, unsigned long long n=1) { cfMetrics[id].fetch_add(n, std::memory_order_relaxed); }
+inline void cfMax(CfMetric id, unsigned long long n) {
+ auto old=cfMetrics[id].load(std::memory_order_relaxed);
+ while(old<n && !cfMetrics[id].compare_exchange_weak(old,n,std::memory_order_relaxed)) {}
+}
+void cfWakeUi();
+void cfRequestPresent();
+void cfPresentTick();
+#endif

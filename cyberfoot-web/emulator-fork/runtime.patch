diff --git a/source/sdl/emscripten/cyberfoot_perf.cpp b/source/sdl/emscripten/cyberfoot_perf.cpp
new file mode 100644
index 0000000..ec19a65
--- /dev/null
+++ b/source/sdl/emscripten/cyberfoot_perf.cpp
@@ -0,0 +1,37 @@
+// Cyberfoot-specific, optional web runtime instrumentation (GPL-2.0-or-later).
+#include "boxedwine.h"
+#if defined(__EMSCRIPTEN__) && defined(BOXEDWINE_MULTI_THREADED)
+#include "cyberfoot_perf.h"
+#include "knativesystem.h"
+#include "../../x11/x11.h"
+#include <emscripten/emscripten.h>
+#include <emscripten/threading.h>
+#include <emscripten/proxying.h>
+std::atomic<unsigned long long> cfMetrics[CF_METRIC_COUNT]{};
+std::atomic<unsigned> cfMode{0};
+static std::atomic<bool> wakePending{false}, presentPending{false};
+static em_proxying_queue* wakeQueue = em_proxying_queue_create();
+static void cfDrain(void*) {
+ wakePending.store(false);
+ cfAdd(CF_WAKE);
+ if (!isMainthread()) return; // The first normal tick initializes main-thread identity.
+ if (!KNativeSystem::getCurrentInput()->processEvents()) KNativeSystem::cleanup();
+}
+void cfWakeUi() {
+ if (!(cfMode.load(std::memory_order_relaxed)&1)) return;
+ if (wakePending.exchange(true)) { cfAdd(CF_WAKE_COALESCED); return; }
+ if (!emscripten_proxy_async(wakeQueue, emscripten_main_runtime_thread_id(), cfDrain, nullptr)) wakePending.store(false);
+}
+void cfRequestPresent() { presentPending.store(true); cfAdd(CF_DEFERRED_FLUSH); }
+void cfPresentTick() {
+ static double last=0;
+ if (!presentPending.load() || emscripten_get_now()-last<16) return;
+ presentPending.store(false);
+ if (auto server=XServer::getServer(true)) server->draw(true);
+ last=emscripten_get_now();
+}
+extern "C" {
+EMSCRIPTEN_KEEPALIVE double cyberfoot_metric(int id) { return id>=0 && id<CF_METRIC_COUNT ? double(cfMetrics[id].load()) : -1; }
+EMSCRIPTEN_KEEPALIVE void cyberfoot_mode(unsigned mode) { cfMode.store(mode&3); }
+}
+#endif

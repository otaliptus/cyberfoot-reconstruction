diff --git a/source/io/zipreadcache.h b/source/io/zipreadcache.h
new file mode 100644
index 0000000..e1fc4a8
--- /dev/null
+++ b/source/io/zipreadcache.h
@@ -0,0 +1,64 @@
+/* Copyright (C) 2026. GPL-2.0-or-later, consistent with Boxedwine. */
+#ifndef BOXEDWINE_ZIP_READ_CACHE_H
+#define BOXEDWINE_ZIP_READ_CACHE_H
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <list>
+#include <vector>
+
+// One bounded LRU per immutable archive. The owner serializes all operations.
+// Small/large files retain the streaming reader; no eager archive expansion.
+class ZipReadCache {
+public:
+    static constexpr uint64_t capacity = 8 * 1024 * 1024;
+    static constexpr uint64_t minimumEntry = 64 * 1024;
+    static constexpr uint64_t maximumEntry = 4 * 1024 * 1024;
+
+    template<typename Loader>
+    bool read(uint64_t key, uint64_t size, uint64_t pos, uint8_t* buffer,
+              uint32_t len, uint32_t& result, Loader&& loader) {
+        if (!len || size < minimumEntry || size > maximumEntry || pos > size) {
+            return false;
+        }
+        auto entry = std::find_if(entries.begin(), entries.end(),
+            [key](const Entry& value) { return value.key == key; });
+        if (entry == entries.end()) {
+            while (bytes + size > capacity) {
+                bytes -= entries.back().data.size();
+                entries.pop_back();
+            }
+            std::vector<uint8_t> data(static_cast<size_t>(size));
+            if (!loader(data.data(), static_cast<uint32_t>(size))) {
+                return false;
+            }
+            entries.push_front({key, std::move(data)});
+            bytes += size;
+            entry = entries.begin();
+        } else {
+            // The archive's directory offset uniquely identifies immutable data.
+            // Refuse a mismatched length rather than reusing inconsistent bytes.
+            if (entry->data.size() != size) {
+                return false;
+            }
+            entries.splice(entries.begin(), entries, entry);
+        }
+        result = static_cast<uint32_t>(std::min<uint64_t>(len, size - pos));
+        if (result) {
+            std::memcpy(buffer, entry->data.data() + pos, result);
+        }
+        return true;
+    }
+
+    uint64_t sizeBytes() const { return bytes; }
+
+private:
+    struct Entry {
+        uint64_t key;
+        std::vector<uint8_t> data;
+    };
+    std::list<Entry> entries;
+    uint64_t bytes = 0;
+};
+#endif
